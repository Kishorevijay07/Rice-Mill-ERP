# ============================================================================
# Rice Mill ERP — Environment Configuration (example)
# Copy to `.env` and fill real values. NEVER commit a real `.env`.
# Required variables are validated at backend startup (see backend/app/core/config.py).
# ============================================================================

# ---- Application ----
APP_ENV=development                 # development | staging | production
APP_NAME=Rice Mill ERP
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true in staging/production for structured JSON logs

# ---- Backend HTTP ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated exact origins allowed by CORS. No wildcards in production.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Public origin of the frontend, used to build the QR link printed on invoices
# (the "scan to download" page). In production set to your Cloudflare Pages URL
# (no trailing slash), e.g. https://your-app.pages.dev
PUBLIC_APP_BASE_URL=http://localhost:3000

# ---- Security / session ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-a-real-environment-use-a-long-random-value
SESSION_COOKIE_NAME=rmerp_session
SESSION_COOKIE_SECURE=false         # true in staging/production (HTTPS only)
# lax for same-site local dev; set "none" (with SESSION_COOKIE_SECURE=true) when
# the frontend and backend are on different domains (Cloudflare Pages + Render).
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=43200           # 12 hours

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rice_mill_erp
POSTGRES_USER=rice_mill
POSTGRES_PASSWORD=rice_mill_dev_password
# Full SQLAlchemy URL. Overrides the discrete vars above if set. A bare
# postgresql:// URL is routed to the driver named by DB_DRIVER below.
DATABASE_URL=postgresql+psycopg://rice_mill:rice_mill_dev_password@localhost:5432/rice_mill_erp
# Driver for bare postgresql:// URLs: psycopg (default, native) or pg8000
# (pure-Python; use locally when the psycopg binary is blocked, e.g. Windows
# Smart App Control).
DB_DRIVER=psycopg

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- S3-compatible object storage (MinIO for local dev) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rice-mill-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# ---- Observability ----
SENTRY_DSN=                         # optional; leave blank to disable

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
